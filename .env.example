# ==============================================================================
# ZAC 2026 LifeMate - Environment Variables Configuration
# ==============================================================================
# Hướng dẫn sử dụng:
# 1. Sao chép file này thành .env:
#    - Linux/macOS: cp .env.example .env
#    - Windows (PowerShell): Copy-Item .env.example .env
# 2. Điền các giá trị API key và cấu hình thích hợp bên dưới.
# 3. File .env đã được thêm vào .gitignore để bảo mật các secret key.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API KEYS & PROVIDER CONFIGURATION (Tasks A04, A13)
# ------------------------------------------------------------------------------
# Lựa chọn LLM provider: "gemini" | "openai" | "heuristic" | "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Bắt buộc nếu sử dụng provider "gemini")
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-compatible API Key (Nếu sử dụng GPT hoặc dịch vụ proxy)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Base URL cho các server tương thích OpenAI (vLLM, Ollama, OpenRouter, Groq)
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. HUGGING FACE & ASR MODEL CONFIGURATION (Tasks B02, B03, B09)
# ------------------------------------------------------------------------------
# Token Hugging Face nếu tải các checkpoint riêng hoặc gated models
HF_TOKEN=your_huggingface_token_here

# Thư mục cache mô hình cục bộ (mặc định: models/asr)
HF_HOME=models/asr

# Chế độ chạy offline (khi nộp bài thi Docker không có kết nối internet)
# Đặt thành 1 khi chạy trong môi trường thi hoặc kiểm thử offline
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0

# ------------------------------------------------------------------------------
# 3. RUNTIME & SUBMISSION SETTINGS (Tasks A16, A17)
# ------------------------------------------------------------------------------
# Thiết bị chạy suy luận: "auto" | "cuda" | "cpu"
DEVICE=auto

# Giới hạn số tool calls tối đa cho mỗi mẫu (theo luật cuộc thi ZAC 2026)
MAX_TOOL_CALLS=12

# Giới hạn số bước suy luận (agent reasoning steps) tối đa
MAX_AGENT_STEPS=8

# Thời gian timeout tối đa cho mỗi mẫu (giây)
TIMEOUT_PER_SAMPLE=10.0

# Mức độ ghi log: "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO

# Đường dẫn thư mục xuất kết quả nộp bài
OUTPUT_DIR=result

